{
  "name": "docquest",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run free-ports && concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "free-ports": "node scripts/free-dev-ports.js",
    "dev:backend": "python -W ignore::FutureWarning -m uvicorn api:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}